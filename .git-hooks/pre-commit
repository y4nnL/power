#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
cd "$REPO_ROOT"

export PATH="$REPO_ROOT/node_modules/.bin:$PATH"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required to run pre-commit checks" >&2
  exit 1
fi

pnpm format:check
pnpm lint
