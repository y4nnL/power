{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "outputs": []
    },
    "lint:config": {
      "dependsOn": ["^lint:config"],
      "outputs": []
    },
    "lint:config:fix": {
      "dependsOn": ["^lint:config:fix"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test", "^test:e2e", "test:e2e"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^test:e2e"],
      "outputs": []
    },
    "format": {
      "dependsOn": ["^format"],
      "outputs": []
    },
    "format:fix": {
      "dependsOn": ["^format:fix"],
      "outputs": []
    },
    "format:config": {
      "dependsOn": ["^format:config"],
      "outputs": []
    },
    "format:config:fix": {
      "dependsOn": ["^format:config:fix"],
      "outputs": []
    }
  }
}
